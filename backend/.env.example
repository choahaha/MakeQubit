# Frontend origin allowed by CORS (Railway/Vercel deploy URL)
FRONTEND_URL=
# How many student programs may execute at the same time
MAX_CONCURRENT_RUNS=4

# --- 연구자 조회 API (admin.html) ---
SUPABASE_URL=https://igzzobxbnbngofpppaoj.supabase.co

# Supabase Dashboard → Settings → API → service_role
# RLS를 통째로 우회하는 키다. 서버 밖으로 나가면 안 된다:
#  - 프론트엔드 .env의 VITE_* 에 넣지 말 것 (번들에 그대로 실린다)
#  - 아래 ADMIN_TOKEN 자리에 넣지 말 것 (브라우저에 입력되고
#    sessionStorage에 남고 요청 헤더로 매번 오간다)
SUPABASE_SERVICE_KEY=

# 연구자 화면 암호. service_role 키와 반드시 다른, 무작위 문자열.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
